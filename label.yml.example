# Label configuration — copy to label.yml and fill in your values.
# label.yml is gitignored (contains label-specific info).

channel:
  name: "Your Label Instrumentals"
  url: "https://www.youtube.com/channel/YOUR_CHANNEL_ID"
  description: |
    Official instrumental versions of tracks by Your Label.
    Extracted using AI source separation.

label:
  name: "Your Label"

templates:
  # Supported tags:
  #   <artist-name>          — primary artist (channel owner)
  #   <track-title>          — raw track title from yt-dlp/YTMusic
  #   <video-title>          — final rendered YouTube upload title (recommended for descriptions)
  #   <album-name>           — album name
  #   <original-url>         — URL of the original YouTube video
  #   <original-channel-url> — URL of the original YouTube channel
  #   <model-name>           — separation model used (e.g. HTDemucs)
  #   <label-name>           — label name from label.name above
  #   <artist-tag>           — artist name sanitized for hashtag use
  #   <channel-url>          — URL of the instrumentals YouTube channel
  #   <channel-name>         — display name of the instrumentals YouTube channel

  video_title: "<artist-name> — <track-title> (Instrumental)"

  video_description: |
    <video-title>

    Separated using <model-name>.
    Original video: <original-url>
    Original channel: <original-channel-url>

    This is an official instrumental provided by <label-name>.
    Channel: <channel-url>
    All rights reserved.

    <artist-tag> #instrumental

  album_playlist_name: "<artist-name> — <album-name> (Instrumentals)"
  artist_playlist_name: "<artist-name> (Instrumentals)"
  # Single per-label playlist that receives every upload, in chronological order.
  channel_playlist_name: "<channel-name> Uploaded Instrumentals"

  # Optional template for YouTube Shorts. If omitted, defaults to adding
  # "Full instrumental: <full-video-url>\n\n" before video_description.
  # short_description: |
  #   Full instrumental: <full-video-url>
  #
  #   <video-title>
  #   Original video: <original-url>
  #   <artist-tag> #instrumental #shorts

# YouTube Shorts options (mutually exclusive):
# upload_short: blindly upload 20s short for every instrumental
# upload_short_if_music_video: upload 20s short only if source is detected as an active music video
upload_short: false
upload_short_if_music_video: false

# When true: create a playlist for every contributor — both co-billed primaries
# ("A & B", "A, B") and featured guests ("(feat. X)" in titles). When false: use
# the raw primary artist string as a single playlist name. From a label's
# perspective, even an equal-billing collab with an outside artist shouldn't
# auto-promote them — so the public default is false.
create_playlists_for_collaborators: false

# Separation backend used when --model is not passed on the CLI.
# Choices:
#   htdemucs   — 4-stem demucs v4. CPU-friendly, ~7x realtime on Pi 4.
#   inst_hq_4  — UVR-MDX-NET Inst_HQ_4 (ONNX). Cleaner vocals removal but
#                ~12x realtime + 3 GB RAM on Pi 4. Best on x86/GPU.
default_model: htdemucs

# When true: trim silent or vocals-only sections at the start and end of instrumentals.
trim_silence: true


# Default tab to scan for source channels ("videos" or "releases"). Defaults to "videos".
tab: videos

# Source channels to scan. Each entry: a YouTube or YouTube Music channel URL,
# an after_date (YYYYMMDD), an optional tab ("videos" or "releases"), optionally
# preserve_original_video_title: true to preserve the raw video title, optionally
# create_album_playlists: false to disable album playlist creation (defaults to true),
# and optionally video_channel_url to source official music videos for YouTube Shorts.
sources:
  - url: "https://music.youtube.com/channel/UCH1C5-gc2yyK_Sw0VxqxKHA"  # artist releases / topic
    video_channel_url: "https://www.youtube.com/@sample-source-5"             # official music video channel
    after_date: "20260101"
  - url: "https://youtube.com/@aggregator_channel"
    after_date: "20260315"
    preserve_original_video_title: true
    create_album_playlists: false


# Artist alias groups — names that refer to the same artist.
# The first name in each group is the canonical name used for playlists.
# Any variation encountered (in metadata, titles, etc.) resolves to it.
# Example:
#   artist_aliases:
#     - ["Artist Full Name", "Artist Abbrev", "ArtistAltSpelling"]
#     - ["Band Name", "Band Abbreviation"]
artist_aliases: []
